# === NoneBot2 框架配置 ===
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# === OneBot v11 连接配置 ===
# 方式一：正向 WS（NoneBot 主动连接 NapCat）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# 方式二：反向 WS（NapCat 主动连接 NoneBot）
# 不需要额外配置，NapCat 连到 ws://你的IP:8080/onebot/v11/ws 即可
ONEBOT_ACCESS_TOKEN=

# === LongCat LLM 配置 ===
LONGCAT_API_BASE=https://api.longcat.ai/v1
LONGCAT_API_KEY=your-longcat-api-key
LONGCAT_MODEL=longcat-chat
LONGCAT_TEMPERATURE=0.7
LONGCAT_MAX_TOKENS=2048

# === 数据库配置 ===
DATABASE_URL=sqlite:///./data/qqbot.db

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION=30

# === 知识库配置 ===
KNOWLEDGE_DIR=./data/knowledge
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# === 反垃圾配置 ===
ANTISPAM_RULES_DIR=./data/rules
ANTISPAM_THRESHOLD_LLM=40
ANTISPAM_THRESHOLD_BAN=70
ANTISPAM_THRESHOLD_KICK=90

# === 美团分析配置 ===
MEITUAN_DATA_DIR=./data/meituan

# === 调试模式 ===
DEBUG=false
