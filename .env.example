# .env.example

# === NoneBot2 框架配置 ===
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# === OneBot v11 连接配置 ===
ONEBOT_ACCESS_TOKEN=

# === LLM 配置 ===
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# === 数据库配置 ===
DATABASE_URL=sqlite:///./data/qqbot.db

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION=30

# === 知识库配置 ===
KNOWLEDGE_DIR=./data/knowledge
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# === 反垃圾配置 ===
ANTISPAM_RULES_DIR=./data/rules
ANTISPAM_THRESHOLD_LLM=40
ANTISPAM_THRESHOLD_BAN=70
ANTISPAM_THRESHOLD_KICK=90

# === 数据分析配置 ===
DATA_ANALYSIS_DIR=./data/analysis

# === 调试模式 ===
DEBUG=false
